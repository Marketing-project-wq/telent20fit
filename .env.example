# ---------------------------------------------------------------------------
# 20FIT Talent — KOL app environment variables
# Copy to .env for local dev. On Railway, set these in the Variables tab.
# ---------------------------------------------------------------------------

# Port (Railway injects this automatically at runtime — no need to set there).
PORT=3000

# --- Supabase (required) --------------------------------------------------
# Project API URL.
SUPABASE_URL=https://cpvzwqptzcxnwzfzgrmt.supabase.co

# Service-role key — SECRET. The server uses it for all data + storage access
# (talent accounts, submissions, campaigns, images). Never expose in a browser.
# Supabase dashboard → Project Settings → API → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Talent session (optional) --------------------------------------------
# HMAC secret for signing talent login cookies. If unset, the service-role key
# is used. Set a dedicated random value if you want to rotate sessions.
# SESSION_SECRET=some-long-random-string

# --- Staff accounts (Super Admin / EO) ------------------------------------
# Staff log in at /admin/login with accounts stored in the database
# (staff_accounts table). The first super admin is seeded directly in the DB.
# The old ADMIN_USER / ADMIN_PASSWORD (HTTP Basic auth) are no longer used.

# --- Local dev only -------------------------------------------------------
# Set to "memory" to run without Supabase (in-process data, resets on restart).
# KOL_STORE_MODE=memory
