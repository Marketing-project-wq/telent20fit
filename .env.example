# ---------------------------------------------------------------------------
# Environment variables for the 20FIT Talent static server
# ---------------------------------------------------------------------------

# Port the server listens on.
# NOTE: On Railway you do NOT need to set this — Railway injects PORT
# automatically at runtime. This value is only used for local development.
PORT=3000

# Optional: explicitly choose which HTML file to serve.
# By default the server serves index.html, or the first *.html file it finds
# in the project root. Uncomment and set this if you want to be explicit.
# HTML_FILE=20FIT Talent (offline).html
