# ---------------------------------------------------------------------------
# 20FIT Talent — KOL app environment variables
# Copy to .env for local dev. On Railway, set these in the Variables tab.
# ---------------------------------------------------------------------------

# Port (Railway injects this automatically at runtime — no need to set there).
PORT=3000

# --- Supabase -------------------------------------------------------------
# Project API URL.
SUPABASE_URL=https://cpvzwqptzcxnwzfzgrmt.supabase.co

# Anon / publishable key — safe for the public submission form (protected by RLS).
# Supabase dashboard → Project Settings → API → "anon"/"publishable" key.
SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — SECRET. Used server-side for the admin dashboard & leaderboard.
# Supabase dashboard → Project Settings → API → "service_role" key.
# Never expose this in a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin login (HTTP Basic auth for /admin and /performance) ------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
